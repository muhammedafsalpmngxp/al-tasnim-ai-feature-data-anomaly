# Copy to .env and fill in real values. NEVER commit .env.
#
# This file is INDEPENDENT of the Al-Tasnim chatbot's .env. Changing anything here cannot
# affect the chatbot, and vice versa — that separation is deliberate, because the two systems
# deliberately see DIFFERENT slices of the same database (see TABLE SCOPE below).

# ── LLM provider ────────────────────────────────────────────────────────────────
# openai / open  -> OpenAI (OPENAI_MODEL) via OPENAI_API_KEY
# local          -> Ollama (LLM_MODEL) via OLLAMA_BASE_URL
LLM_PROVIDER=openai

# MAIN model — the reasoning tier. Used by the nodes whose judgement decides whether a probe is
# correct: the Anomaly SQL Author, the Rule Verifier, and the Findings Summarizer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# FAST model — the cheap tier. Used by Grounding (mapping business language onto real tables).
# Blank = fall back to OPENAI_MODEL, so leaving it unset is safe, never broken.
OPENAI_FAST_MODEL=gpt-4o-mini

# Local Ollama (ignored while LLM_PROVIDER=openai; kept so switching back is one edit)
LLM_MODEL=qwen3.6:35b-a3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
OLLAMA_FAST_MODEL=

# Per-request timeout. Without it a stalled provider call holds a worker thread — and its DB
# connection — forever, while /api/health still reports OK.
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2

# ── Database (MS SQL) ───────────────────────────────────────────────────────────
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
# Leave blank to auto-detect (ODBC Driver 18 -> 17 -> SQL Server).
DB_DRIVER=
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# ── TABLE SCOPE — what the anomaly engine may see ───────────────────────────────
# This is the ONLY place table visibility is decided. No table or column name appears anywhere
# in the Python code (enforced by eval/test_no_business_sql.py).
#
# ⚠ DELIBERATELY WIDER THAN THE CHATBOT'S SCOPE. The chatbot hides tables to keep its prompt
# small and unambiguous for question-answering. An anomaly detector wants the OPPOSITE: more
# tables means more declared foreign keys to check for orphans, and — more importantly — it can
# compare two sources that are supposed to agree (e.g. a WBS master against the activity CSV).
# Cross-source disagreement is one of the highest-value anomaly families, and it is invisible if
# only one of the two sources is in scope.
#
# Hide anything that turns out to be noisy by adding it below — no code change, and the cache
# rebuilds itself on the next run.
ALLOWED_SCHEMAS=dbo,dsq,project,ref,well,core,bridge,wbs

# Comma-separated. "schema.table" hides one exact table (preferred); a bare "table" hides that
# name in EVERY allowed schema. A hidden table also disappears from the primary keys, foreign
# keys and value hints, because each is built from the surviving table list.
# Default hides only genuine non-data objects — diagrams and duplicate/legacy copies.
EXCLUDED_TABLES=dbo.sysdiagrams

# Individual columns to hide, on top of the built-in secret-name filter (password/token/secret/
# apikey/credential, which always applies and needs no configuration). Use
# "schema.table.column" (preferred), "table.column" for that table in any schema, or a bare
# "column" to hide that name in EVERY table.
EXCLUDED_COLUMNS=

# ── Row-volume control ──────────────────────────────────────────────────────────
# Four SEPARATE caps, because they solve four different problems. Collapsing them into one
# number is how an anomaly report ends up either truncated or unopenable.
#
# 1. What an LLM is ever shown, per rule. This is a TOKEN-COST control and the reason a probe's
#    result can never blow the context window: no prompt in this system contains more rows.
ANOMALY_SAMPLE_ROWS=25
# 2. Rows per rule in the Word document. Word is a document format — a table of 50,000 rows is
#    both enormous and unopenable. The DETAIL query is ordered worst-first, so a cap still shows
#    the rows that matter, and the document states the true total.
ANOMALY_REPORT_ROWS=2000
# 3. Rows per rule sheet in Excel. Streamed in batches into a write-only worksheet, so memory
#    stays flat regardless of size. The .xlsx format's own hard limit is 1,048,576 rows/sheet.
ANOMALY_EXPORT_MAX_ROWS=1000000
# 4. Rows fetched per batch while streaming to Excel. Larger = fewer round trips, more memory.
ANOMALY_FETCH_BATCH=5000

# ── Query execution ─────────────────────────────────────────────────────────────
# Two timeouts, deliberately. A SUMMARY query returns ONE row and should be quick; a DETAIL
# query legitimately scans and can take minutes. Making detail inherit the summary timeout means
# every large rule fails as a timeout rather than returning findings.
ANOMALY_QUERY_TIMEOUT=60
ANOMALY_DETAIL_TIMEOUT=600
# Parallel probes during a detection run. Bounded on purpose — these are scanning queries, and
# an unbounded pool would hurt the source database more than the report is worth.
ANOMALY_RUN_CONCURRENCY=3
# Parallel rules during a compile. 1 keeps the log readable and respects provider rate limits.
ANOMALY_COMPILE_CONCURRENCY=1
# Run every probe under READ UNCOMMITTED so a full scan never blocks production writers.
# Issued as a separate statement ON THE CONNECTION by our own code — it is never part of the
# validated SQL, so it cannot weaken the SELECT-only gate.
ANOMALY_READ_UNCOMMITTED=true

# ── Agentic guardrails ──────────────────────────────────────────────────────────
# SQL rewrites per rule for a MECHANICAL failure: rejected by the safety validator, a database
# error, or a broken SUMMARY/DETAIL column contract.
MAX_SQL_RETRIES=2
# Rewrites the Verifier may demand for a SEMANTIC failure. Kept SEPARATE from MAX_SQL_RETRIES on
# purpose: sharing one budget lets unrelated syntax errors earlier in a rule leave the Verifier
# with no rewrites left, so it rejects and is immediately overruled.
VERIFY_RETRIES=1
# Hard circuit breaker on a whole compile. One pathological rule cannot burn the budget.
# How many members of one structural family may be sent to the SQL Author before the
# family is written off. Each member names DIFFERENT tables and columns, so a second
# attempt is a genuinely different query - not a retry of a rejected one. One rejected
# representative used to take every sibling with it: 50 probes lost in a single compile.
ANOMALY_FAMILY_AUTHOR_ATTEMPTS=3
ANOMALY_MAX_COMPILE_CALLS=200
# Prune the schema block to the tables Grounding named, once the database has more tables than
# this. Below the threshold the author always sees the full block. Pruning falls back to the
# full schema whenever Grounding named nothing, so it can never starve the author.
ANOMALY_SCHEMA_PRUNE_ABOVE_TABLES=60
# Cut business_rules.md down to the sections one rule plausibly needs, instead of sending the
# whole file on every author and verifier call. A section is kept when it names one of the
# rule's own tags, when it is small, or when it shares enough of the rule's vocabulary - and
# the whole file is sent whenever the saving would be marginal.
#
# few_shots.md is cut too, but never by scoring - that removed the lessons preventing the most
# common failures, because it teaches probe craft in the engine's vocabulary rather than the
# business's. Each worked example DECLARES when it applies (`applies:` in the file itself) and
# only the declaration is read. This switch turns that off as well.
#
# Set to false if a probe is ever rejected for a reason that looks like missing context. It is
# the cheapest thing to rule out, and costs only tokens.
ANOMALY_REFERENCE_PRUNE=true
# Sections at or below this many characters are never dropped - too little to save, too much to
# risk. Raise to be safer, lower to cut more.
ANOMALY_REFERENCE_KEEP_BELOW=900
# A large section is dropped only when it speaks to less than this share of the rule's own
# vocabulary AND names none of its tags. Deliberately low: keeping an unneeded section costs a
# few hundred tokens, dropping a needed definition costs a probe that measures the wrong thing.
ANOMALY_REFERENCE_MIN_OVERLAP=0.10
# Rebuild outdated probes automatically before a detection run. Staleness is judged PER PROBE,
# against the tables that probe reads, so this rebuilds the few left behind by a rename rather
# than the whole catalog. false = refuse to run them and tell the operator to run
# `python -m app.cli compile`. Either way, SQL that no longer matches the schema is never
# executed and reported as a finding.
ANOMALY_AUTO_COMPILE=true
# The most probes one run will rebuild by itself. Above this it refuses and asks for an explicit
# compile: that many going stale at once means the schema changed broadly, and an hour of LLM
# calls should not start inside a run someone is waiting on.
ANOMALY_AUTO_COMPILE_MAX_RULES=25

# ── Observability ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_CONSOLE=true            # colour agent trace in the terminal
LOG_CONSOLE_MAX_CHARS=0     # 0 = never truncate (full SQL, full verifier feedback)

# ── HTTP API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8100               # 8100, not 8000 — so it can run alongside the chatbot
API_RELOAD=false
API_WORKERS=1
# Blank = no auth (local dev only). The comment MUST stay on its own line: with an
# EMPTY value, python-dotenv reads a trailing inline comment AS the value, so
# API_KEY=   # blank ... silently sets the key to the comment text and every
# request then fails with 401.
API_KEY=
CORS_ORIGINS=*

# ── Langfuse tracing (optional, self-hosted) ────────────────────────────────────
# ENTIRELY OPT-IN. Blank public key => no handler is attached anywhere and every code path is
# identical to the pre-Langfuse behaviour. Traces carry the FULL prompt and response of every
# LLM call, which here includes retrieved business rows — point this ONLY at a trusted,
# access-controlled instance.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# How much a finding of each severity moves the headline score. A BUSINESS judgement, not an
# engineering one, so it lives here rather than in Python. Omit for the defaults below; the
# RATIOS matter more than the absolute values. An organisation that treats any critical defect
# as unacceptable might use critical:100,high:20,medium:8,low:1.
ANOMALY_SEVERITY_WEIGHTS=critical:40,high:20,medium:8,low:5

# A text column counts as "really a quantity" once at least this share of its values parse as
# numbers; below it the column holds codes, labels or free text and no cast probe is built over
# it. MEASURED from the data, never guessed from the column name. On this database every text
# column measures either <= 32% (codes) or >= 95% (numeric), with a single one at 71%, so the
# default sits in that gap. Lower it to include a borderline column.
ANOMALY_TEXT_NUMERIC_MIN_PARSE=0.80

# A probe whose scope equals its anomalies is REFUSED once its scope reaches this size. Below
# it, a small population genuinely can be entirely bad - one check legitimately reported 5 of 5
# - so it is raised as an advisory for the reviewer instead. A saturated scope in the thousands
# is not that: it reads to a business audience as "100% of this is broken" about a population
# defined as the broken things.
ANOMALY_SATURATION_FLOOR=50

# How close a probe's scope may come to a table's full row count before its de-duplication is
# judged to have done nothing. Not zero: a probe legitimately drops rows with a NULL measure,
# and the case that prompted this read 110,181 against 110,184 rows. A probe that examines every
# stored row of a table the schema marks MANY ROWS PER is counting updates rather than things,
# so every percentage it reports is against the wrong denominator.
ANOMALY_DEDUP_SCOPE_TOLERANCE=0.01
