DB_SERVER=20.98.112.250
DB_PORT=1433
DB_NAME=AlTasnimBI
DB_USER=BIuser
DB_PASSWORD=



ALLOWED_SCHEMAS=dbo,dsq,project,ref,well,core,bridge
# Tables hidden from the LLM even though their schema is allowed - backups, copies, empty
# leftovers. Use schema.table (exact) or a bare table name. Blank = hide nothing.
EXCLUDED_TABLES=well.well_details,dbo.sysdiagrams,dbo.plant_description,ref.project_type,ref.well_location,wbs.Plant_master,wbs.WBS_master,wbs.activity_master,dbo.activity_task_plan,dbo.activity_taskplan_job_progress,dbo.ActivityCodesNorms,dbo.activity_master_mapping,well.wmr_conversion
# Columns hidden on top of the built-in secret-name filter. Use schema.table.column,
# table.column, or a bare column name. Blank = hide nothing.
EXCLUDED_COLUMNS=




LLM_PROVIDER=openai
OPENAI_API_KEY=
# The one model every LLM job uses by default (narrate/agent/correlate/summary).
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# Data Quality & Anomaly Sentinel  (independent of the chat feature's scope)
# ============================================================================
DQ_ALLOWED_SCHEMAS=dbo,dsq,project,ref,well,core,bridge,wbs
DQ_EXCLUDED_TABLES=dbo.sysdiagrams,well.well_details,well.wmr_conversion
DQ_LARGE_TABLE_ROW_LIMIT=2000000
DQ_SAMPLE_PERCENT=2

DQ_LLM_ENABLED=true
DQ_LLM_MAX_TOKENS_PER_BATCH=90000
DQ_LLM_TEMPERATURE=0.1
DQ_LLM_MAX_RETRIES=2
DQ_LLM_TIMEOUT_SECONDS=60
# Optional: run ONE specific job on a different model than OPENAI_MODEL. Leave blank to
# use OPENAI_MODEL for everything (the default, and normally all you need). See docs/05.
DQ_LLM_MODEL_NARRATE=
DQ_LLM_MODEL_AGENT=
DQ_LLM_MODEL_CORRELATE=
DQ_LLM_MODEL_SUMMARY=

# Findings store: BIuser is db_datareader only (measured), so no dq schema is possible.
DQ_STORE=sqlite
DQ_STORE_PATH=./output/sentinel.db
DQ_OUTPUT_DIR=./output

# --- source connection tuning ---
DQ_DB_CONNECT_TIMEOUT=30
DQ_DB_QUERY_TIMEOUT=300
DQ_DB_MAXDOP=2

# --- logging ---
DQ_LOG_LEVEL=INFO
DQ_LOG_JSON=false

API_HOST=0.0.0.0
API_PORT=8001
API_CORS_ORIGINS=http://localhost:5173
DQ_MAX_CONCURRENT_RUNS=2
